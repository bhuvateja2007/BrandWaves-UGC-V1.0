# ==============================================================================
# BrandWaves Full-Stack Environment Configuration — Phase 2
# ==============================================================================

# Server Network Configuration
PORT=3001
VITE_API_BASE_URL=/api

# ------------------------------------------------------------------------------
# Supabase Client Configuration (Safe for frontend exposure in Vite bundle)
# Obtain these from: Supabase Dashboard -> Project Settings -> API
# ------------------------------------------------------------------------------
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-or-anon-key

# ------------------------------------------------------------------------------
# Supabase Server-Side Secret Key (DO NOT EXPOSE TO FRONTEND)
# Used exclusively by Node.js server for privileged admin operations and migrations
# Obtain from: Supabase Dashboard -> Project Settings -> API -> service_role key
# ------------------------------------------------------------------------------
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-never-share

# ------------------------------------------------------------------------------
# SUPABASE DASHBOARD AUTHENTICATION SETTINGS GUIDELINES:
#
# 1. Site URL (Authentication -> URL Configuration):
#    - Development: http://localhost:5173
#    - Production:  https://your-production-domain.com
#
# 2. Redirect URLs Allowlist:
#    - http://localhost:5173/auth/callback
#    - http://localhost:5173/reset-password
#    - https://your-production-domain.com/auth/callback
#    - https://your-production-domain.com/reset-password
#
# 3. Email Authentication & Verification (Authentication -> Providers -> Email):
#    - Enable Email Provider: ON
#    - Confirm Email: ON (Recommended for production integrity)
#    - Secure email change: ON
#
# 4. Strict Login Credential Policy:
#    - Email address & Password ONLY.
#    - No social logins (Google, Facebook, Apple).
#    - No phone OTP.
# ------------------------------------------------------------------------------
